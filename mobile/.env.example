# Copy to .env and fill as needed. EXPO_PUBLIC_* values are bundled into the app:
# never put secrets here — all provider keys live on the API server.

# Whimway API (the Next.js app in the repo root). Leave empty in development:
# devices use your computer's LAN address on port 3000 automatically.
EXPO_PUBLIC_API_URL=
# Public web origin for share links (recipients open plans without the app).
EXPO_PUBLIC_SHARE_ORIGIN=
# Optional accounts (email one-time code). Same project as the API's Supabase.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
