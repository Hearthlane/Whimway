# Browser key: HTTP-referrer restrictions; Maps JavaScript API only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional own cloud map ID; Google's documented DEMO_MAP_ID works in development.
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Server key: restrict APIs to Places API (New), Routes API, Geocoding API.
GOOGLE_MAPS_SERVER_KEY=
# Use WHIMWAY_OPENAI_KEY in cloud settings (OPENAI_ names are platform-reserved).
WHIMWAY_OPENAI_KEY=
# OPENAI_API_KEY is also supported for conventional local/Vercel setups.
OPENAI_API_KEY=
# Set a Structured Outputs capable model available to your account.
WHIMWAY_OPENAI_MODEL=
# Alternative name for conventional local/Vercel setups.
OPENAI_MODEL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Distributed limits required on production expensive endpoints (Upstash REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_GUEST_GENERATIONS=3
DAILY_MEMBER_GENERATIONS=12
DAILY_REMIX_LIMIT=15
GLOBAL_DAILY_PROVIDER_LIMIT=300
GLOBAL_DAILY_REQUEST_LIMIT=3000
# Counts actual Google/OpenAI HTTP attempts, including reopens, photos and retries.
GLOBAL_DAILY_PROVIDER_REQUEST_LIMIT=1000
# Recommended canonical application origin on deployment.
APP_ORIGIN=
# OFF by default. Never enables fixtures in production.
WHIMWAY_DEMO_MODE=false
NEXT_PUBLIC_WHIMWAY_DEMO_MODE=false
