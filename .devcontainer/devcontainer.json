{
  "name": "Whimway preview",
  "image": "node:24-bookworm",
  "forwardPorts": [
    8090,
    3000
  ],
  "portsAttributes": {
    "8090": {
      "label": "Whimway app (browser preview)",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "3000": {
      "label": "Whimway API, web app and share links",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postCreateCommand": "npm ci --no-audit --no-fund && (cd mobile && npm ci --no-audit --no-fund)",
  "postAttachCommand": "bash scripts/preview.sh"
}
